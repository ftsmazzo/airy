{
  "name": "@airy/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Airy — agente de voz desktop",
  "author": "Fábrica IA",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview:orb": "vite --config vite.orb.config.ts",
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:orb": "vite build --config vite.orb.config.ts",
    "start": "electron .",
    "dist:win": "npx electron-builder --win --x64 --config electron-builder.yml",
    "dist:mac": "npx electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@airy/agent": "*",
    "@airy/voice": "*",
    "dotenv": "^16.4.7",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
