# Opcional — preferível configurar no app (token ou tecla ,) → cofre do SO.
# Se existir, é importado uma vez para o cofre local.

# Provisionador de credenciais (VPS) — POST /v1/redeem
# Default no app: https://airy-provisioner.kxryyk.easypanel.host
# AIRY_PROVISIONER_URL=https://airy-provisioner.kxryyk.easypanel.host

# OpenRouter (cérebro + tools)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Pesquisa web (Perplexity). sonar ≈ $1/M; sonar-pro é bem mais caro.
AIRY_RESEARCH_MODEL=perplexity/sonar

# ElevenLabs Pro (TTS + STT)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
# Modelo TTS (mesmo nome da UI/conta Pro)
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_SPEED=1.0

# MCP ie-dados (path-token, sem header)
MCP_TOKEN=...
MCP_BASE_URL=https://ie-dados-mcp.kxryyk.easypanel.host

# Atalho Radar Municipal (URL completa do bookmark)
AIRY_RADAR_URL=https://example.com/radar-municipal

# Persona editável (opcional; default persona/AIRY_PERSONA.md)
# AIRY_PERSONA_PATH=./persona/AIRY_PERSONA.md

# Nome do dono (cumprimentos/confirmações naturais)
AIRY_OWNER_NAME=Fred
