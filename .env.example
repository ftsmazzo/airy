# OpenRouter (cérebro + tools)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ElevenLabs Pro (TTS + STT)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
# Opcional: modelo TTS (default eleven_multilingual_v2)
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# MCP ie-dados (path-token, sem header)
MCP_TOKEN=...
MCP_BASE_URL=https://ie-dados-mcp.kxryyk.easypanel.host

# Atalho Radar Municipal (URL completa do bookmark)
AIRY_RADAR_URL=https://example.com/radar-municipal
