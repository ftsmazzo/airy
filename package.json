{
  "name": "airy",
  "version": "0.1.0",
  "private": true,
  "description": "Airy — agente de voz PT-BR com MCP ie-dados e orbe",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @airy/desktop",
    "preview:orb": "npm run preview:orb -w @airy/desktop",
    "build": "npm run build -w @airy/voice && npm run build -w @airy/agent && npm run build -w @airy/desktop",
    "start": "npm run start -w @airy/desktop",
    "setup:mac": "bash scripts/setup-mac.sh",
    "desktop-shortcut": "node scripts/make-icon-ico.mjs && node scripts/install-desktop-shortcut.mjs",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke-text.mjs",
    "smoke:clap": "node scripts/smoke-clap.mjs",
    "smoke:accept": "node scripts/smoke-accept.mjs"
  },
  "devDependencies": {
    "dotenv": "^16.4.7"
  },
  "engines": {
    "node": ">=20"
  }
}
